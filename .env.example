# 第三阶段：大模型配置模板
#
# 用法：把本文件复制成 .env（同目录），填上自己的 key。
#   copy .env.example .env        (Windows CMD)
#   cp .env.example .env          (Git Bash)
#
# .env 已经被 .gitignore 排除，不会入库 —— **不要把真 key 写进本文件**。
# 也可以不用 .env，直接在命令行 set 环境变量，效果一样（命令行优先）。
#
# 一个 key 都不填也能跑：页面会照常显示检索结果和引用，只是不生成答案正文。


# ---- 方式一：Anthropic（Claude）----
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# LLM_MODEL=claude-sonnet-5

# ---- 方式二：任意 OpenAI 兼容接口 ----
# DeepSeek / 通义 / 智谱 / Kimi / Ollama / vLLM 都是这个协议，换个 BASE_URL 就行。
# OPENAI_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 本地 Ollama 的例子（不用联网、不花钱）：
#   ollama pull qwen2.5:7b
# OPENAI_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# ---- 可选 ----
# LLM_PROVIDER=anthropic|openai|none   # 不写就按上面哪个 key 存在自动挑；none = 明确关闭
# LLM_TIMEOUT=120                      # 秒
# LLM_MAX_TOKENS=1500

# 检索相关性低于这个余弦就拒答，不调用大模型。默认 0.58 是实测标定的，
# 改小会让无关问题也去问模型，改大会误伤真实问题（题库最低 0.629）。
# QA_MIN_COSINE=0.58
